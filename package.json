{
    "name": "dotfiles",
    "type": "module",
    "scripts": {
        "build": "esbuild src/index.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/dotfiles.cjs --banner:js=\"#!/usr/bin/env node\"",
        "typecheck": "tsc -b",
        "lint": "oxlint --config oxlint.config.ts",
        "lint:fix": "oxlint --config oxlint.config.ts --fix",
        "fmt": "oxfmt",
        "fmt:check": "oxfmt --check",
        "checklist": "pnpm typecheck && pnpm lint:fix && pnpm fmt"
    },
    "dependencies": {
        "commander": "^15.0.0",
        "es-toolkit": "^1.50.0",
        "ts-pattern": "^5.9.0",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@types/node": "^26.2.0",
        "esbuild": "^0.28.2",
        "oxfmt": "^0.63.0",
        "oxlint": "^1.78.0",
        "oxlint-tsgolint": "^7.0.2001",
        "typescript": "^7.0.2"
    },
    "devEngines": {
        "packageManager": {
            "name": "pnpm",
            "version": "^11.3.0",
            "onFail": "download"
        }
    }
}
